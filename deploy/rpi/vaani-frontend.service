[Unit]
Description=VAANI Frontend (static build via serve)
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/vaani/frontend
# Serve the production build (install: npm i -g serve)
ExecStart=/usr/local/bin/serve -s build -l 3000
Restart=always
RestartSec=3
MemoryMax=250M

[Install]
WantedBy=multi-user.target
