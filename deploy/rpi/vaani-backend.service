[Unit]
Description=VAANI Backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/vaani/backend
Environment=VAANI_MODE=device
Environment=VAANI_HARDWARE=raspberry_pi
EnvironmentFile=/home/pi/vaani/backend/.env
ExecStart=/home/pi/vaani/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3
# Keep memory modest on a 2GB Pi
MemoryMax=900M

[Install]
WantedBy=multi-user.target
